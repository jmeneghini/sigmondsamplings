<KBFit>
    <Initialize>
        <ProjectName>PhiRhoDetRes</ProjectName>
        <LogFile>PhiRhoDetRes.log</LogFile>
        <EchoXML/>
        <MCSamplingInfo>
            <Bootstrapper>
                <NumberResamplings>2000</NumberResamplings>
                <Seed>0</Seed>
                <BootSkip>0</BootSkip>
            </Bootstrapper>
            <!-- <Jackknife/> -->
        </MCSamplingInfo>
    </Initialize>
    <TaskSequence>
        <Task>
            <Action>DoFit</Action>

            <Type>DeterminantResidualFit</Type>

            <MinimizerInfo>
                <Method>NL2Sno</Method>
                <ParameterRelTol>1e-6</ParameterRelTol>
                <ChiSquareRelTol>1e-4</ChiSquareRelTol>
                <MaximumIterations>1024</MaximumIterations>
                <Verbosity>Low</Verbosity>
            </MinimizerInfo>

            <OutSamplingsFile>samplings.hdf5[/samplings]</OutSamplingsFile>
            <EcmQcmBoxSamplingsStub>ecm_qcm_box_samplings</EcmQcmBoxSamplingsStub>

            <DeterminantResidualFit>

                <OmegaMu>8.0</OmegaMu>
                <QuantizationCondition>KtildeinvB</QuantizationCondition>
                <Verbose/>

                <KtildeMatrixInverse>

                    <Element>
                        <KElementInfo>
                            <JTimesTwo>0</JTimesTwo>
                            <KIndex>L(0) 2S(0) chan(0)</KIndex>
                            <KIndex>L(0) 2S(0) chan(0)</KIndex>
                        </KElementInfo>
                        <FitForm>
                            <Expression>
                            <String>0.5*sqrt(x^2 - 4.0)*(rho_mass_ref^2 - x^2)/(rho_mass_ref * Gamma_ref)</String>
                            </Expression>
                        </FitForm> <!-- Breit-Wigner -->
                    </Element>

                    <DecayChannels>
                        <DecayChannelInfo>
                            <Particle1Name>phi</Particle1Name>
                            <Spin1TimesTwo>0</Spin1TimesTwo>
                            <Identical/>
                        </DecayChannelInfo>
                    </DecayChannels>

                    <StartingValues>
                        <KFitParamInfo>
                            <StringExpressionParameter>
                                <ParameterName>rho_mass_ref</ParameterName>
                                <KElementInfo>
                                    <JTimesTwo>0</JTimesTwo>
                                    <KIndex>L(0) 2S(0) chan(0)</KIndex>
                                    <KIndex>L(0) 2S(0) chan(0)</KIndex>
                                </KElementInfo>
                            </StringExpressionParameter>
                            <StartingValue>2.71</StartingValue>
                        </KFitParamInfo>

                        <KFitParamInfo>
                            <StringExpressionParameter>
                                <ParameterName>Gamma_ref</ParameterName>
                                <KElementInfo>
                                    <JTimesTwo>0</JTimesTwo>
                                    <KIndex>L(0) 2S(0) chan(0)</KIndex>
                                    <KIndex>L(0) 2S(0) chan(0)</KIndex>
                                </KElementInfo>
                            </StringExpressionParameter>
                            <StartingValue>0.0008</StartingValue>
                        </KFitParamInfo>
                    </StartingValues>

                </KtildeMatrixInverse>

                <DefaultEnergyFormat>reference_ratio</DefaultEnergyFormat>

                <MCEnsembleParameters>
                    <MCEnsembleInfo>phirho_s24_t48_mp0100_mr0310|3332000|1|24|24|24|48</MCEnsembleInfo>
                    <ReferenceMassTimeSpacingProduct>
                        <MCObs>Phi(0)_elab 0</MCObs>
                    </ReferenceMassTimeSpacingProduct>
                    <ParticleMass>
                        <Name>phi</Name>
                        <FixedValue>1.0</FixedValue>
                    </ParticleMass>
