<KBFit>
    <Initialize>
        <ProjectName>PhiRhoSpectrum_s46_s47</ProjectName>
        <OutputDirectory>../results/PhiRhoSpectrum_s46_s47</OutputDirectory>
        <LogFile>PhiRhoSpectrum_s46_s47.log</LogFile>
        <EchoXML/>
        <MCSamplingInfo>
            <Bootstrapper>
                <NumberResamplings>2000</NumberResamplings>
                <Seed>0</Seed>
                <BootSkip>0</BootSkip>
            </Bootstrapper>
            <!-- <Jackknife/> -->
        </MCSamplingInfo>
    </Initialize>
    <TaskSequence>
        <Task>
            <Action>DoFit</Action>

            <Type>SpectrumFit</Type>

            <MinimizerInfo>
                <Method>Minuit2Migrad</Method>
                <ParameterRelTol>1e-6</ParameterRelTol>
                <ChiSquareRelTol>1e-4</ChiSquareRelTol>
                <MaximumIterations>1024</MaximumIterations>
                <Verbosity>Low</Verbosity>
            </MinimizerInfo>

            <OutSamplingsFile>fit_param_samplings.hdf5[/samplings]</OutSamplingsFile>

            <SpectrumFit>

                <OmegaMu>0.8</OmegaMu>
                <QuantizationCondition>StildeCB</QuantizationCondition>

                <RootFinder>
                   <AdaptiveBracket/>
                   <MinStepPercent>1e-5</MinStepPercent>
                   <MaxStepPercent>5e-3</MaxStepPercent>
                   <AbsXTolerance>1e-5</AbsXTolerance>
                </RootFinder>

                <Verbose/>

                <KtildeMatrixInverse>

                    <Element>
                        <KElementInfo>
                            <JTimesTwo>0</JTimesTwo>
                            <KIndex>L(0) 2S(0) chan(0)</KIndex>
                            <KIndex>L(0) 2S(0) chan(0)</KIndex>
                        </KElementInfo>
                        <FitForm>
                            <Expression>
                            <String>0.5*sqrt(x^2 - 4.0)*(rho_mass_ref^2 - x^2)/(rho_mass_ref * Gamma_ref)</String>
                            </Expression>
                        </FitForm> <!-- Breit-Wigner -->
                    </Element>

                    <DecayChannels>
                        <DecayChannelInfo>
                            <Particle1Name>phi</Particle1Name>
                            <Spin1TimesTwo>0</Spin1TimesTwo>
                            <Identical/>
                        </DecayChannelInfo>
                    </DecayChannels>

                    <StartingValues>
                        <KFitParamInfo>
                            <StringExpressionParameter>
                                <ParameterName>rho_mass_ref</ParameterName>
                                <KElementInfo>
                                    <JTimesTwo>0</JTimesTwo>
                                    <KIndex>L(0) 2S(0) chan(0)</KIndex>
                                    <KIndex>L(0) 2S(0) chan(0)</KIndex>
                                </KElementInfo>
                            </StringExpressionParameter>
                            <StartingValue>2.70425</StartingValue>
                        </KFitParamInfo>

                        <KFitParamInfo>
                            <StringExpressionParameter>
                                <ParameterName>Gamma_ref</ParameterName>
                                <KElementInfo>
                                    <JTimesTwo>0</JTimesTwo>
                                    <KIndex>L(0) 2S(0) chan(0)</KIndex>
                                    <KIndex>L(0) 2S(0) chan(0)</KIndex>
                                </KElementInfo>
                            </StringExpressionParameter>
                            <StartingValue>0.00151675</StartingValue>
                        </KFitParamInfo>
                    </StartingValues>

                </KtildeMatrixInverse>

                <DefaultEnergyFormat>reference_ratio</DefaultEnergyFormat>]

                <MCEnsembleParameters>
                    <MCEnsembleInfo>phirho_s46_t48_mp0100_mr0310|750000|1|46|46|46|48</MCEnsembleInfo>
                    <ReferenceMassTimeSpacingProduct>
                        <MCObs>Phi(0)_elab 0</MCObs>
                    </ReferenceMassTimeSpacingProduct>
                    <ParticleMass>
                        <Name>phi</Name>
                        <FixedValue>1.0</FixedValue>
                    </ParticleMass>
                </MCEnsembleParameters>

                <MCEnsembleParameters>
                    <MCEnsembleInfo>phirho_s47_t48_mp0100_mr0310|700000|1|47|47|47|48</MCEnsembleInfo>
