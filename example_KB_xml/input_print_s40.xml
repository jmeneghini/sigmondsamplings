<KBFit>
    <Initialize>
        <ProjectName>PhiRhoPrint_s40_6_23_25_omega_08</ProjectName>
        <OutputDirectory>../results/PhiRhoPrint_s40</OutputDirectory>
        <LogFile>PhiRhoPrint_s40.log</LogFile>
        <EchoXML/>
        <MCSamplingInfo>
            <Bootstrapper>
                <NumberResamplings>2000</NumberResamplings>
                <Seed>0</Seed>
                <BootSkip>0</BootSkip>
            </Bootstrapper>
            <!-- <Jackknife/> -->
        </MCSamplingInfo>
    </Initialize>
    <TaskSequence>
        <Task>
            <Action>DoPrint</Action>

            <OutputStub>../test</OutputStub>
            <OutputMode>full</OutputMode>

                <OmegaMu>0.8</OmegaMu>
                <QuantizationCondition>StildeCB</QuantizationCondition>
                <!-- <OmegaMu>8.0</OmegaMu>
                <QuantizationCondition>KtildeB</QuantizationCondition> -->
                <RootFinder>
                   <AdaptiveBracket/>
                   <MinStepPercent>1e-5</MinStepPercent>
                   <MaxStepPercent>5e-3</MaxStepPercent>
                </RootFinder>
                <Verbose/>

                <KtildeMatrixInverse>

                    <Element>
                        <KElementInfo>
                            <JTimesTwo>0</JTimesTwo>
                            <KIndex>L(0) 2S(0) chan(0)</KIndex>
                            <KIndex>L(0) 2S(0) chan(0)</KIndex>
                        </KElementInfo>
                        <FitForm>
                            <Expression>
                            <String>(0.5*sqrt(x^2 - 4.0)*(rho_mass_ref^2 - x^2)/(rho_mass_ref * Gamma_ref))</String>
                            </Expression>
                        </FitForm> <!-- Breit-Wigner -->
                    </Element>

                    <DecayChannels>
                        <DecayChannelInfo>
                            <Particle1Name>phi</Particle1Name>
                            <Spin1TimesTwo>0</Spin1TimesTwo>
                            <Identical/>
                        </DecayChannelInfo>
                    </DecayChannels>

                    <StartingValues>
                        <KFitParamInfo>
                            <StringExpressionParameter>
                                <ParameterName>rho_mass_ref</ParameterName>
                                <KElementInfo>
                                    <JTimesTwo>0</JTimesTwo>
                                    <KIndex>L(0) 2S(0) chan(0)</KIndex>
                                    <KIndex>L(0) 2S(0) chan(0)</KIndex>
                                </KElementInfo>
                            </StringExpressionParameter>
                            <StartingValue>2.70575334362</StartingValue>
                        </KFitParamInfo>

                        <KFitParamInfo>
                            <StringExpressionParameter>
                                <ParameterName>Gamma_ref</ParameterName>
                                <KElementInfo>
                                    <JTimesTwo>0</JTimesTwo>
                                    <KIndex>L(0) 2S(0) chan(0)</KIndex>
                                    <KIndex>L(0) 2S(0) chan(0)</KIndex>
                                </KElementInfo>
                            </StringExpressionParameter>
                            <StartingValue>0.00149603005047</StartingValue>
                            <!-- <StartingValue>0.01</StartingValue>  -->
                        </KFitParamInfo>

                    </StartingValues>

                </KtildeMatrixInverse>

                <DefaultEnergyFormat>reference_ratio</DefaultEnergyFormat>

                <MCEnsembleParameters>
                    <MCEnsembleInfo>phirho_s40_t48_mp0100_mr0310|728000|1|40|40|40|48</MCEnsembleInfo>
                    <ReferenceMassTimeSpacingProduct>
                        <MCObs>Phi(0)_elab 0</MCObs>
                    </ReferenceMassTimeSpacingProduct>
                    <ParticleMass>
                        <Name>phi</Name>
                        <FixedValue>1.0</FixedValue>
                    </ParticleMass>
                </MCEnsembleParameters>

                

                <KBBlock>
                    <MCEnsembleInfo>phirho_s40_t48_mp0100_mr0310|728000|1|40|40|40|48</MCEnsembleInfo>
                    <BoxQuantization>
                        <TotalMomentumRay>ar</TotalMomentumRay>
                        <TotalMomentumIntSquared>0</TotalMomentumIntSquared>
                        <LGIrrep>A1g</LGIrrep>
                        <LmaxValues>0</LmaxValues>
                    </BoxQuantization>
                    <LabFrameEnergyMin>2.01</LabFrameEnergyMin>
                    <LabFrameEnergyMax>3.9</LabFrameEnergyMax>
                    <LabFrameEnergyInc>0.001</LabFrameEnergyInc>
                </KBBlock>

                <KBBlock>
                    <MCEnsembleInfo>phirho_s40_t48_mp0100_mr0310|728000|1|40|40|40|48</MCEnsembleInfo>
                    <BoxQuantization>
                        <TotalMomentumRay>oa</TotalMomentumRay>
                        <TotalMomentumIntSquared>1</TotalMomentumIntSquared>
                        <LGIrrep>A1</LGIrrep>
                        <LmaxValues>0</LmaxValues>
                    </BoxQuantization>
                    <LabFrameEnergyMin>2.7</LabFrameEnergyMin>
                    <LabFrameEnergyMax>3.9</LabFrameEnergyMax>
                    <LabFrameEnergyInc>0.001</LabFrameEnergyInc>
                </KBBlock>


                <KBObservables>
                    <MCSamplingInfo>
                        <Bootstrapper>
                        <NumberResamplings>2000</NumberResamplings>
                        <Seed>0</Seed>
                        <BootSkip>0</BootSkip>
                        </Bootstrapper>
                        <!-- <Jackknife/> -->
                    </MCSamplingInfo>
                    <Verbose />
                    <SamplingData>
                        <FileName>../../../levels/john_results/s40/3fit_spectrum/data/samples/fit_spectrum_levels_sigmond-6-14-25-no_ratio_interacting_vev_sub-Nbin26-SP-3tN-3t0-6tD_B-samplings.hdf5[/samplings]</FileName>
                    </SamplingData>
                </KBObservables>
        </Task>
    </TaskSequence>
</KBFit>

